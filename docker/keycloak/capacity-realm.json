{
  "realm": "capacity",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "roles": {
    "realm": [
      { "name": "origination", "description": "Invoice origination system" },
      { "name": "bank-operator", "description": "Bank operations staff" },
      { "name": "bank-auditor", "description": "Audit, risk and compliance" },
      { "name": "buyer", "description": "Programme owner (obligor)" }
    ]
  },
  "clientScopes": [
    {
      "name": "basic",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "capacity-audience",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "capacity-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "client-ref",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "client_ref",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "client_ref",
            "claim.name": "client_ref",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "reservations:write",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "programs:read:all",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "programs:read:own",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "breaks:read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "audit:read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    }
  ],
  "scopeMappings": [
    { "clientScope": "reservations:write", "roles": ["origination"] },
    {
      "clientScope": "programs:read:all",
      "roles": ["origination", "bank-operator", "bank-auditor"]
    },
    { "clientScope": "programs:read:own", "roles": ["buyer"] },
    { "clientScope": "breaks:read", "roles": ["bank-operator", "bank-auditor"] },
    { "clientScope": "audit:read", "roles": ["bank-auditor"] }
  ],
  "clients": [
    {
      "clientId": "origination",
      "name": "Invoice origination",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "origination-local-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "basic",
        "capacity-audience",
        "reservations:write",
        "programs:read:all"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "capacity-local",
      "name": "Local demo login (password grant, local only)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "basic",
        "capacity-audience",
        "client-ref",
        "programs:read:all",
        "programs:read:own",
        "breaks:read",
        "audit:read"
      ],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "service-account-origination",
      "enabled": true,
      "serviceAccountClientId": "origination",
      "realmRoles": ["origination"]
    },
    {
      "username": "operator",
      "enabled": true,
      "email": "operator@capacity.local",
      "emailVerified": true,
      "firstName": "Olivia",
      "lastName": "Operator",
      "realmRoles": ["bank-operator"],
      "credentials": [{ "type": "password", "value": "operator", "temporary": false }]
    },
    {
      "username": "auditor",
      "enabled": true,
      "email": "auditor@capacity.local",
      "emailVerified": true,
      "firstName": "Arthur",
      "lastName": "Auditor",
      "realmRoles": ["bank-auditor"],
      "credentials": [{ "type": "password", "value": "auditor", "temporary": false }]
    },
    {
      "username": "buyer-acme",
      "enabled": true,
      "email": "treasury@acme.local",
      "emailVerified": true,
      "firstName": "Acme",
      "lastName": "Buyer",
      "attributes": { "client_ref": ["C-ACME"] },
      "realmRoles": ["buyer"],
      "credentials": [{ "type": "password", "value": "buyer-acme", "temporary": false }]
    },
    {
      "username": "buyer-globex",
      "enabled": true,
      "email": "treasury@globex.local",
      "emailVerified": true,
      "firstName": "Globex",
      "lastName": "Buyer",
      "attributes": { "client_ref": ["C-GLOBEX"] },
      "realmRoles": ["buyer"],
      "credentials": [{ "type": "password", "value": "buyer-globex", "temporary": false }]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"client_ref\",\"displayName\":\"Client reference\",\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[]}"
          ]
        }
      }
    ]
  }
}

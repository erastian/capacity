{
  "name": "capacity",
  "version": "0.0.1",
  "description": "Programme capacity and invoice reservation service: reserves credit capacity for invoices and keeps it in step with treasury over Kafka",
  "author": "Erastian",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/ scripts/",
    "simulate": "node scripts/treasury-simulator.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-fastify": "^12.1.2",
    "@platformatic/kafka": "^2.14.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "decimal.js": "^10.6.0",
    "jose": "^6.2.12",
    "nestjs-pino": "^5.3.1",
    "pg": "8.23.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.2",
    "dotenv": "^18.0.6",
    "oxlint": "^1.58.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.4.2",
    "prisma": "7.10.0",
    "testcontainers": "^12.2.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "mysql2": "^3.24.6",
    "deepmerge-ts": "^8.0.2"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true,
    "protobufjs": false,
    "ssh2": false,
    "cpu-features": false
  }
}
